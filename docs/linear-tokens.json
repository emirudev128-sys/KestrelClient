{
  "bodyBg": "rgb(8, 9, 10)",
  "bodyColor": "rgb(247, 248, 248)",
  "bodyFont": "\"Inter Variable\", \"SF Pro Display\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, \"Open Sans\", \"Helvetica Neue\", sans-serif",
  "varCount": 153,
  "vars": {
    "--toast-icon-margin-start": "4px",
    "--toast-icon-margin-end": "-3px",
    "--toast-svg-margin-start": "0px",
    "--toast-svg-margin-end": "-1px",
    "--toast-button-margin-start": "0",
    "--toast-button-margin-end": "auto",
    "--toast-close-button-start": "unset",
    "--toast-close-button-end": "0",
    "--toast-close-button-transform": "translate(35%, -35%)",
    "--gray1": "hsl(0, 0%, 99%)",
    "--gray2": "hsl(0, 0%, 97.3%)",
    "--gray3": "hsl(0, 0%, 95.1%)",
    "--gray4": "hsl(0, 0%, 93%)",
    "--gray5": "hsl(0, 0%, 90.9%)",
    "--gray6": "hsl(0, 0%, 88.7%)",
    "--gray7": "hsl(0, 0%, 85.8%)",
    "--gray8": "hsl(0, 0%, 78%)",
    "--gray9": "hsl(0, 0%, 56.1%)",
    "--gray10": "hsl(0, 0%, 52.3%)",
    "--gray11": "hsl(0, 0%, 43.5%)",
    "--gray12": "hsl(0, 0%, 9%)",
    "--border-radius": "8px",
    "--y": "translateY(40%)",
    "--lift-amount": "calc(var(--lift) * var(--gap))",
    "--lift": "-1",
    "--scale": "var(--toasts-before) * 0.05 + 1",
    "--normal-bg": "#000",
    "--normal-border": "hsl(0, 0%, 20%)",
    "--normal-text": "var(--gray1)",
    "--success-bg": "hsl(150, 100%, 6%)",
    "--success-border": "hsl(147, 100%, 12%)",
    "--success-text": "hsl(150, 86%, 65%)",
    "--info-bg": "hsl(215, 100%, 6%)",
    "--info-border": "hsl(223, 43%, 17%)",
    "--info-text": "hsl(216, 87%, 65%)",
    "--warning-bg": "hsl(64, 100%, 6%)",
    "--warning-border": "hsl(60, 100%, 9%)",
    "--warning-text": "hsl(46, 87%, 65%)",
    "--error-bg": "hsl(358, 76%, 10%)",
    "--error-border": "hsl(357, 89%, 16%)",
    "--error-text": "hsl(358, 100%, 81%)",
    "--normal-bg-hover": "hsl(0, 0%, 12%)",
    "--normal-border-hover": "hsl(0, 0%, 25%)",
    "--size": "16px",
    "--track-size": "4px",
    "--track-active-size": "7px",
    "--moreHitArea-inset": "-12px -2px",
    "--volume-size": "32px",
    "--height": "44px",
    "--gradientBorder-gradient": "linear-gradient(92.88deg, #be05ff 9.16%, #a954ff 43.89%, #a771ff 64.72%)",
    "--gradientBorder-size": "2px",
    "--title-line-height": "24px",
    "--padding": "16px",
    "--bg": "var(--color-bg-tertiary)",
    "--border": "var(--color-border-secondary)",
    "--list-inset": "24px",
    "--block-spacing-small": "8px",
    "--block-spacing": "16px",
    "--h1-size": "var(--title-5-size)",
    "--h1-line-height": "var(--title-5-line-height)",
    "--h1-letter-spacing": "var(--title-5-letter-spacing)",
    "--h2-size": "var(--title-3-size)",
    "--h2-line-height": "var(--title-3-line-height)",
    "--h2-letter-spacing": "var(--title-3-letter-spacing)",
    "--h2-bottom-margin": "12px",
    "--h3-size": "var(--title-3-size)",
    "--h3-line-height": "var(--title-3-line-height)",
    "--h3-letter-spacing": "var(--title-3-letter-spacing)",
    "--h3-bottom-margin": "16px",
    "--h4-size": "var(--title-1-size)",
    "--h4-line-height": "var(--title-1-line-height)",
    "--h4-letter-spacing": "var(--title-1-letter-spacing)",
    "--h4-bottom-margin": "18px",
    "--figure-margin": "32px",
    "--p-size": "var(--text-large-size)",
    "--p-line-height": "var(--text-large-line-height)",
    "--p-letter-spacing": "var(--text-large-letter-spacing)",
    "--wide-inset": "calc((var(--page-max-width) - var(--page-padding-left) - var(--page-padding-right) - var(--prose-max-width)))",
    "--image-figure-margin": "48px",
    "--image-figure-margin-tablet": "32px",
    "--visibility-delay": "0s",
    "--direction": "to bottom",
    "--color": "rgba(var(--color-alpha), var(--color-alpha), var(--color-alpha), .1)",
    "--tweet-container-margin": "0",
    "--tweet-header-font-size": "15px",
    "--tweet-header-line-height": "22px",
    "--tweet-body-font-size": "15px",
    "--tweet-body-font-weight": "var(--font-weight-normal)",
    "--tweet-body-line-height": "22px",
    "--tweet-body-margin": "0",
    "--tweet-quoted-container-margin": ".75rem 0",
    "--tweet-quoted-body-font-size": ".938rem",
    "--tweet-quoted-body-font-weight": "400",
    "--tweet-quoted-body-line-height": "1.25rem",
    "--tweet-quoted-body-margin": ".25rem 0 .75rem 0",
    "--tweet-info-font-size": "13px",
    "--tweet-info-line-height": "13px",
    "--tweet-actions-font-size": ".875rem",
    "--tweet-actions-line-height": "1rem",
    "--tweet-actions-font-weight": "700",
    "--tweet-actions-icon-size": "1.25em",
    "--tweet-actions-icon-wrapper-size": "calc(var(--tweet-actions-icon-size) + .75em)",
    "--tweet-replies-font-size": ".875rem",
    "--tweet-replies-line-height": "1rem",
    "--tweet-replies-font-weight": "700",
    "--tweet-skeleton-gradient": "linear-gradient(270deg, #15202b, #1e2732, #1e2732, #15202b)",
    "--tweet-border": "1px solid var(--color-border-primary)",
    "--tweet-font-family": "var(--font-regular)",
    "--tweet-font-color": "var(--color-text-primary)",
    "--tweet-font-color-secondary": "var(--color-text-tertiary)",
    "--tweet-bg-color": "var(--color-bg-primary)",
    "--tweet-bg-color-hover": "var(--color-bg-secondary)",
    "--tweet-quoted-bg-color-hover": "var(--color-bg-tertiary)",
    "--tweet-color-blue-primary": "#1d9bf0",
    "--tweet-color-blue-primary-hover": "#1a8cd8",
    "--tweet-color-blue-secondary": "#6bc9fb",
    "--tweet-color-blue-secondary-hover": "#6bc9fb1a",
    "--tweet-color-red-primary": "#f91880",
    "--tweet-color-red-primary-hover": "#f918801a",
    "--tweet-color-green-primary": "#00ba7c",
    "--tweet-color-green-primary-hover": "#00ba7c1a",
    "--tweet-twitter-icon-color": "var(--color-text-quaternary)",
    "--tweet-verified-old-color": "#829aab",
    "--tweet-verified-blue-color": "#fff",
    "--grid-gap": "0",
    "--asset-inset": "20px",
    "--edge-highlight-radius": "var(--slide-radius)",
    "--px": "calc(100cqw / var(--design-width))",
    "--page-padding-left": "calc(max(var(--homepage-outer-padding), (100vw - var(--homepage-max-width)) / 2 + var(--homepage-outer-padding)) + var(--homepage-padding-inset))",
    "--page-max-width": "calc((100vw - var(--page-padding-left) * 2) * (1164 / 1344))",
    "--Carousel-gap": "20px",
    "--slide-width": "min(var(--page-max-width), calc(100vw - var(--page-padding-left) * 2))",
    "--slide-radius": "calc(var(--slide-width) * 12 / 1164)",
    "--edge-highlight-color": "#ffffff1f",
    "--token-comment": "#62666d",
    "--token-string": "#ffdf9f",
    "--token-constant": "#8fa6ff",
    "--token-variable": "#f7bf8b",
    "--token-keyword": "#e391cf",
    "--token-entity": "#83dcdc",
    "--token-punctuation": "#d0d6e0",
    "--token-text": "#d0d6e0",
    "--diff-char-added-bg": "#27a6442e",
    "--diff-char-removed-bg": "#fc31422e",
    "--Switch-height": "20px",
    "--Switch-width": "32px",
    "--Switch-thumb-size": "14px",
    "--diff": "calc(var(--Switch-height) - var(--Switch-thumb-size))",
    "--gap": "calc(var(--diff) / 2)",
    "--sticky-reserve": "125px",
    "--first-row-gap": "57px",
    "--table-bg": "var(--color-bg-primary)",
    "--button-gap": "10px"
  },
  "fonts": [
    "Inter Variable",
    "Berkeley Mono"
  ],
  "sizes": [
    "10px",
    "11px",
    "12px",
    "13px",
    "13.3333px",
    "14px",
    "15px",
    "16px",
    "17px",
    "18px",
    "20px",
    "24px",
    "32px",
    "48px",
    "64px",
    "72px"
  ],
  "radii": [
    "6px",
    "9999px",
    "12px",
    "4px",
    "2px",
    "7px",
    "400px",
    "50%",
    "8px",
    "22px",
    "12px 12px 0px 0px",
    "16px",
    "1px",
    "4px 0px 0px 4px",
    "0px 4px 4px 0px",
    "2px 0px 0px 2px",
    "0px 2px 2px 0px",
    "20px"
  ]
}
